---
const base = import.meta.env.BASE_URL;
---
<header class="site-header">
  <div class="wrap">
    <a href={base} class="logo" aria-label="Triple9 Design — home">
      <img src={`${base}images/triple9-logo.jpg`} alt="Triple9 Design" />
    </a>
    <nav class="nav" id="siteNav" aria-label="Primary">
      <a class="nav-link" href={`${base}services/`}>Services</a>
      <a class="nav-link" href={`${base}about/`}>About</a>
      <a class="nav-link" href={`${base}contact/`}>Contact</a>
      <a class="btn btn-accent" href={`${base}contact/`}>Get a quote</a>
    </nav>
    <button class="menu-btn" id="menuBtn" aria-label="Open menu">≡</button>
  </div>
</header>
