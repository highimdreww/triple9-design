---
import contact from '../content/contact.json';
---

<div class="quote-form-shell">
  <form id="quote-form" class="quote-form">
    <div class="form-row">
      <div class="form-field">
        <label for="quote-name">Your name <span>*</span></label>
        <input
          id="quote-name"
          name="name"
          type="text"
          autocomplete="name"
          placeholder="Your full name"
          required
        />
      </div>

      <div class="form-field">
        <label for="quote-business">Business name <span>*</span></label>
        <input
          id="quote-business"
          name="business"
          type="text"
          autocomplete="organization"
          placeholder="Your business"
          required
        />
      </div>
    </div>

    <div class="form-row">
      <div class="form-field">
        <label for="quote-email">Email address <span>*</span></label>
        <input
          id="quote-email"
          name="email"
          type="email"
          autocomplete="email"
          placeholder="you@business.com"
          required
        />
      </div>

      <div class="form-field">
        <label for="quote-phone">Phone number <span>*</span></label>
        <input
          id="quote-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          placeholder="(407) 555-0123"
          required
        />
      </div>
    </div>

    <fieldset class="services-fieldset">
      <legend>What services are you interested in? <span>*</span></legend>

      <p>Select everything that applies.</p>

      <div class="service-checkbox-grid">
        {contact.serviceOptions.map((service, index) => (
          <label class="service-checkbox">
            <input
              type="checkbox"
              name="services"
              value={service}
              id={`service-option-${index}`}
            />
            <span class="checkbox-indicator" aria-hidden="true"></span>
            <span>{service}</span>
          </label>
        ))}
      </div>

      <p
        class="form-error"
        id="service-selection-error"
        role="alert"
        hidden
      >
        Please select at least one service.
      </p>
    </fieldset>

    <div class="form-field">
      <label for="quote-details">Tell us about your project <span>*</span></label>

      <textarea
        id="quote-details"
        name="details"
        rows="6"
        placeholder="Tell us about your business, your goals, and what you’re looking to accomplish."
        required
      ></textarea>
    </div>

    <button type="submit" class="button-gold form-submit">
      Prepare my inquiry
      <span class="button-mark" aria-hidden="true"></span>
    </button>

    <p class="form-fineprint">
      Submitting prepares an email in your email application.
      You’ll need to send it to complete your request.
    </p>
  </form>

  <div
    id="quote-success"
    class="quote-success"
    role="status"
    aria-live="polite"
    hidden
  >
    <span class="section-kicker">NEXT STEP</span>

    <h3>{contact.successHeading}</h3>

    <p>{contact.successMessage}</p>

    <a
      id="quote-email-link"
      class="button-gold"
      href={`mailto:${contact.email}`}
    >
      Open prepared email
      <span class="button-mark" aria-hidden="true"></span>
    </a>

    <button
      type="button"
      class="form-reset"
      id="quote-start-over"
    >
      Start another inquiry
    </button>
  </div>
</div>

<script define:vars={{ recipient: contact.email }}>
  const form = document.getElementById('quote-form');
  const success = document.getElementById('quote-success');
  const emailLink = document.getElementById('quote-email-link');
  const startOver = document.getElementById('quote-start-over');
  const selectionError = document.getElementById('service-selection-error');

  if (form && success && emailLink && startOver && selectionError) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      const data = new FormData(form);
      const services = data.getAll('services').map(String);

      if (services.length === 0) {
        selectionError.hidden = false;

        const firstCheckbox = form.querySelector(
          'input[name="services"]'
        );

        firstCheckbox?.focus();
        return;
      }

      selectionError.hidden = true;

      const name = String(data.get('name') || '').trim();
      const business = String(data.get('business') || '').trim();
      const email = String(data.get('email') || '').trim();
      const phone = String(data.get('phone') || '').trim();
      const details = String(data.get('details') || '').trim();

      const subject = `Triple9 Design Consultation Request — ${business}`;

      const body = [
        'TRIPLE9 DESIGN — CONSULTATION REQUEST',
        '',
        `Name: ${name}`,
        `Business: ${business}`,
        `Email: ${email}`,
        `Phone: ${phone}`,
        '',
        'SERVICES REQUESTED',
        ...services.map((service) => `- ${service}`),
        '',
        'PROJECT DETAILS',
        details
      ].join('\n');

      const mailto =
        `mailto:${recipient}` +
        `?subject=${encodeURIComponent(subject)}` +
        `&body=${encodeURIComponent(body)}`;

      emailLink.setAttribute('href', mailto);

      form.hidden = true;
      success.hidden = false;

      window.location.href = mailto;
    });

    form.querySelectorAll('input[name="services"]').forEach((checkbox) => {
      checkbox.addEventListener('change', () => {
        const selected = form.querySelector(
          'input[name="services"]:checked'
        );

        if (selected) selectionError.hidden = true;
      });
    });

    startOver.addEventListener('click', () => {
      form.reset();
      form.hidden = false;
      success.hidden = true;
      selectionError.hidden = true;
      form.querySelector('input')?.focus();
    });
  }
</script>
