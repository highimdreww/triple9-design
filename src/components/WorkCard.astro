---
interface Props {
  number: string;
  title: string;
  category: string;
  location: string;
  href: string;
  variant?: 'dark' | 'light';
}

const {
  number,
  title,
  category,
  location,
  href,
  variant = 'dark'
} = Astro.props;
---

<a
  class:list={['work-card', variant]}
  href={href}
  aria-label={`View ${title} concept demo`}
>
  <div class="work-card-top">
    <span>{number} / SELECTED WORK</span>
    <span>CONCEPT PROJECT</span>
  </div>

  <div class="work-card-art">
    <div class="art-frame">
      <span class="art-kicker">{category}</span>
      <strong>{title}</strong>
      <span class="art-line"></span>
      <span class="art-location">{location}</span>
    </div>
  </div>

  <div class="work-card-bottom">
    <div>
      <h3>{title}</h3>
      <p>{category} · {location}</p>
    </div>

    <span class="work-card-link">View project <span aria-hidden="true">+</span></span>
  </div>
</a>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: #111;
  }

  .work-card-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 17px 0;
    border-top: 1px solid #bbb;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .work-card-art {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1.2;
    padding: clamp(22px, 4vw, 55px);
    overflow: hidden;
  }

  .dark .work-card-art {
    background: #111;
    color: white;
  }

  .light .work-card-art {
    background: #e8e8e5;
    color: #111;
  }

  .art-frame {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    width: 100%;
    height: 100%;
    padding: clamp(22px, 3vw, 42px);
    border: 1px solid currentColor;
    transition: transform .8s cubic-bezier(.22,1,.36,1);
  }

  .work-card:hover .art-frame {
    transform: scale(1.035);
  }

  .art-kicker,
  .art-location {
    font-size: 10px;
    font-weight: 650;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .art-kicker {
    margin-bottom: auto;
  }

  .art-frame strong {
    max-width: 600px;
    font-size: clamp(36px, 5vw, 80px);
    font-weight: 750;
    line-height: .99;
    letter-spacing: -.075em;
  }

  .art-line {
    width: 100%;
    height: 1px;
    margin: 28px 0 15px;
    background: currentColor;
    opacity: .4;
  }

  .work-card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 25px 0;
  }

  .work-card-bottom h3 {
    margin: 0 0 8px;
    font-size: clamp(20px, 2.3vw, 30px);
    font-weight: 650;
    letter-spacing: -.055em;
  }

  .work-card-bottom p {
    margin: 0;
    color: #777;
    font-size: 12px;
  }

  .work-card-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    flex: none;
    font-size: 11px;
    font-weight: 650;
  }

  .work-card-link span {
    font-size: 23px;
    font-weight: 400;
    transition: transform .3s ease;
  }

  .work-card:hover .work-card-link span {
    transform: rotate(90deg);
  }

  @media (max-width: 600px) {
    .work-card-top {
      font-size: 8px;
    }

    .work-card-art {
      aspect-ratio: 1;
    }

    .art-frame strong {
      font-size: clamp(38px, 10vw, 65px);
    }

    .work-card-link {
      font-size: 10px;
    }
  }
</style>
