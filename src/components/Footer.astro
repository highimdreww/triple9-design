---
import contact from '../content/contact.json';
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="footer-brand">
    <div class="wrap">
      <a class="footer-logo" href={base} aria-label="Triple9 Design home">
        <img src={`${base}images/triple9-logo.jpg`} alt="Triple9 Design" width="1290" height="727" loading="lazy" decoding="async" />
      </a>
    </div>
  </div>
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <p class="footer-tag">Orlando, Florida</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href={`${base}services/`}>Services</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}contact/`}>Contact</a>
      </nav>
      <address class="footer-contact">
        <a href={contact.phoneHref}>{contact.phone}</a>
        <a href={`mailto:${contact.email}`}>{contact.email}</a>
      </address>
    </div>
    <p class="footer-bottom">© 2026 Triple9 Design.</p>
  </div>
</footer>
