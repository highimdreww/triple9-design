---
import contact from '../content/contact.json';

const base = import.meta.env.BASE_URL;

const links = [
  { label: 'Home', href: base },
  { label: 'Services', href: `${base}services/` },
  { label: 'About', href: `${base}about/` },
  { label: 'Contact', href: `${base}contact/` }
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container-studio">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={base} aria-label="Triple9 Design — Home">
          <img
            src={`${base}images/triple9-logo.jpg`}
            alt="Triple9 Design"
            width="205"
            height="75"
            loading="lazy"
          />
        </a>

        <p>
          Strategy. Identity. Digital.
          <br />
          Built to make an impact.
        </p>
      </div>

      <div class="footer-column">
        <span class="footer-label">EXPLORE</span>

        <nav aria-label="Footer navigation">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>

      <div class="footer-column">
        <span class="footer-label">START A CONVERSATION</span>

        <a href={`mailto:${contact.email}`}>
          {contact.email}
        </a>

        <a href={`tel:${contact.phoneHref}`}>
          {contact.phone}
        </a>

        <span class="footer-location">{contact.location}</span>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} Triple9 Design. All rights reserved.</span>

      <span>CREATIVE WITH PURPOSE. BUILT WITH INTENTION.</span>
    </div>
  </div>
</footer>
