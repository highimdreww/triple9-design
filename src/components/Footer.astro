---
import contact from '../content/contact.json';

const base = import.meta.env.BASE_URL;
const logo = `${base}images/triple9-logo.jpg`;

const links = [
  ['Work', 'work'],
  ['Services', 'services'],
  ['Pricing', 'pricing'],
  ['About', 'about'],
  ['Contact', 'contact']
];
---

<footer class="footer">
  <div class="container-studio">
    <div class="footer-main">
      <div class="footer-brand">
        <a href={base} aria-label="Triple9 Design home">
          <img
            src={logo}
            alt="Triple9 Design"
            width="210"
            height="90"
            loading="lazy"
          />
        </a>

        <p>
          Independent design.
          <br />
          Exceptional execution.
        </p>
      </div>

      <div class="footer-column">
        <span class="footer-label">Explore</span>

        {links.map(([label, anchor]) => (
          <a href={`${base}#${anchor}`}>{label}</a>
        ))}
      </div>

      <div class="footer-column">
        <span class="footer-label">Get in touch</span>

        <a href={`tel:${contact.phoneHref}`}>
          {contact.phone}
        </a>

        <a href={`mailto:${contact.email}`}>
          {contact.email}
        </a>

        <span>{contact.location}</span>
      </div>

      <div class="footer-column footer-hours">
        <span class="footer-label">Availability</span>
        <p>{contact.hours}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} Triple9 Design</span>
      <span>Made with intention in Florida.</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #111;
    color: white;
    padding-top: 95px;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.6fr .7fr 1.1fr 1fr;
    gap: 55px;
    padding-bottom: 110px;
  }

  .footer-brand img {
    width: 210px;
    max-height: 100px;
    object-fit: contain;
    object-position: left center;
  }

  .footer-brand p {
    margin-top: 26px;
    color: #999;
    font-size: 17px;
    line-height: 1.6;
    letter-spacing: -.035em;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
    font-size: 13px;
    line-height: 1.7;
  }

  .footer-column a {
    transition: color .25s ease;
  }

  .footer-column a:hover {
    color: #aaa;
  }

  .footer-label {
    margin-bottom: 14px;
    color: #888;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .footer-hours p {
    margin: 0;
    color: #aaa;
    max-width: 250px;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 28px 0;
    border-top: 1px solid #333;
    color: #888;
    font-size: 11px;
  }

  @media (max-width: 950px) {
    .footer-main {
      grid-template-columns: repeat(2, 1fr);
      gap: 60px 35px;
    }
  }

  @media (max-width: 600px) {
    .footer {
      padding-top: 75px;
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: 45px;
      padding-bottom: 70px;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }
</style>
