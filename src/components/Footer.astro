---
const base = import.meta.env.BASE_URL;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <span class="logo-box">
          <img src={`${base}images/triple9-logo.jpg`} alt="Triple9 Design" />
        </span>
        <p class="footer-tag">A digital agency for local businesses. Websites, branding, and marketing.</p>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href={`${base}services/`}>Services</a>
        <a href={`${base}about/`}>About</a>
        <a href={`${base}contact/`}>Contact</a>
      </nav>
      <div class="footer-contact">
        <p><a class="tel" href="tel:+14077640241">(407) 764-0241</a></p>
        <p><a class="mail" href="mailto:asaunders995@gmail.com">asaunders995@gmail.com</a></p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Triple9 Design.</span>
      <span>Built with intent.</span>
    </div>
  </div>
</footer>
