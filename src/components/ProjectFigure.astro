---
import type home from '../content/home.json';

interface Props {
  project: typeof home.projects[number];
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = project.url.startsWith('https://') ? project.url : `${base}${project.url}`;
---
<figure class:list={['project-shot', { 'project-lead': featured }]}>
  <a class="project-image" href={href} aria-label={`View ${project.name}, ${project.caption}`}>
    <img src={`${base}images/${project.image}`} alt={project.alt} width="1919" height="998"
      loading={featured ? 'eager' : 'lazy'} fetchpriority={featured ? 'high' : 'auto'} decoding="async" />
  </a>
  <figcaption>
    <a href={href}>{project.name}</a>
    <span>{project.caption}</span>
  </figcaption>
</figure>
