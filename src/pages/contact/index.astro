---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';

import contact from '../../content/contact.json';
---

<BaseLayout
  title="Contact | Triple9 Design"
  description="Get in touch with Triple9 Design for branding, web design, social media, advertising, SEO, and website care."
>
  <Header />

  <main class="page-shell">
    <section class="page-hero mesh-surface">
      <div class="page-hero-orbit" aria-hidden="true"></div>

      <div class="container-studio page-hero-content">
        <span class="section-kicker reveal">
          {contact.eyebrow}
        </span>

        <h1 class="page-title reveal delay-1">
          {contact.heading}
        </h1>

        <p class="lead-copy reveal delay-2">
          {contact.intro}
        </p>
      </div>
    </section>

    <section class="contact-grid-section light-surface">
      <div class="container-studio contact-grid">
        <div class="contact-info reveal">
          <span class="section-kicker dark">
            {contact.detailsEyebrow}
          </span>

          <div class="contact-rows">
            <div class="contact-row">
              <span>EMAIL</span>
              <a href={`mailto:${contact.email}`}>{contact.email}</a>
            </div>

            <div class="contact-row">
              <span>PHONE</span>
              <a href={`tel:${contact.phone.replace(/[^+\d]/g, '')}`}>{contact.phone}</a>
            </div>

            <div class="contact-row">
              <span>SERVING</span>
              <p>{contact.serving}</p>
            </div>
          </div>

          <p class="contact-note">{contact.note}</p>

          <div class="contact-why">
            <h3>{contact.whyEyebrow}</h3>

            <ul>
              {contact.whyItems.map((item) => (
                <li>
                  <span class="why-marker" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="contact-form reveal delay-1">
          <span class="section-kicker dark">
            {contact.formEyebrow}
          </span>

          <ContactForm />
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-grid-section {
    padding: 110px 0;
    background: var(--paper);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: clamp(60px, 8vw, 135px);
    align-items: start;
  }

  .contact-rows {
    margin: 50px 0;
    border-top: 1px solid #d7d6d0;
  }

  .contact-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 25px;
    padding: 28px 0;
    border-bottom: 1px solid #d7d6d0;
  }

  .contact-row span {
    flex: 0 0 95px;
    color: #838489;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .14em;
  }

  .contact-row a {
    margin-left: auto;
    text-align: right;
    font-family: var(--font-display);
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 700;
    letter-spacing: -.045em;
    overflow-wrap: anywhere;
  }

  .contact-row a:hover {
    color: var(--gold-deep);
  }

  .contact-row p {
    margin: 0;
    color: #4c4d52;
    font-size: 14px;
    line-height: 1.7;
    text-align: right;
  }

  .contact-note {
    margin: 0 0 60px;
    color: #62656b;
    font-size: 15px;
    line-height: 1.85;
  }

  .contact-why {
    padding-top: 42px;
    border-top: 1px solid #d7d6d0;
  }

  .contact-why h3 {
    margin: 0 0 30px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .contact-why ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-why li {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid #e0dfd8;
    color: #55575d;
    font-size: 14px;
    line-height: 1.75;
  }

  .why-marker {
    flex: 0 0 7px;
    width: 7px;
    height: 7px;
    margin-top: 7px;
    background: var(--gold-deep);
    transform: rotate(45deg);
  }

  .contact-form {
    padding-top: 8px;
  }

  .contact-form .section-kicker {
    display: block;
    margin-bottom: 35px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 70px;
    }

    .contact-rows {
      margin: 35px 0;
    }

    .contact-row {
      flex-direction: column;
      gap: 10px;
    }

    .contact-row a,
    .contact-row p {
      margin-left: 0;
      text-align: left;
    }
  }
</style>
