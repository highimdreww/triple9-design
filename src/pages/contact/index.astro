---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/ContactForm.astro';

import contact from '../../content/contact.json';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Get a Quote | Contact Triple9 Design"
  description="Request a consultation with Triple9 Design for web design, complete rebrands, social media marketing, advertising, SEO, or website hosting and care."
>
  <Header />

  <main class="page-shell">
    <!-- HERO -->

    <section class="page-hero mesh-surface contact-hero">
      <div class="page-hero-orbit" aria-hidden="true"></div>

      <div class="container-studio page-hero-content">
        <span class="section-kicker reveal">
          {contact.eyebrow}
        </span>

        <h1 class="page-title reveal delay-1">
          {contact.headline}
        </h1>

        <p class="lead-copy reveal delay-2">
          {contact.description}
        </p>
      </div>
    </section>

    <!-- CONTACT AND QUOTE REQUEST -->

    <section class="section-pad contact-main">
      <div class="container-studio contact-grid">
        <div class="contact-information reveal">
          <span class="section-kicker dark">
            START THE CONVERSATION
          </span>

          <h2 class="section-title">
            Great work starts with a clear direction.
          </h2>

          <p class="contact-intro">
            Tell us what you're looking to accomplish.
            We'll help you explore the right combination
            of creative, development, and marketing services.
          </p>

          <div class="contact-methods">
            <div class="contact-method">
              <span>CALL US</span>

              <a href={`tel:${contact.phoneHref}`}>
                {contact.phone}
              </a>
            </div>

            <div class="contact-method">
              <span>EMAIL US</span>

              <a href={`mailto:${contact.email}`}>
                {contact.email}
              </a>
            </div>

            <div class="contact-method">
              <span>LOCATION</span>

              <strong>{contact.location}</strong>
            </div>
          </div>

          <div class="contact-side-panel">
            <span>THE NEXT STEP</span>

            <p>
              Share the vision. Define the opportunity.
              Build something exceptional.
            </p>

            <div class="contact-side-line"></div>
          </div>
        </div>

        <div class="contact-form-column reveal delay-1">
          <div class="contact-form-heading">
            <span class="section-kicker dark">
              PROJECT INQUIRY
            </span>

            <h2>{contact.formHeading}</h2>

            <p>{contact.formDescription}</p>
          </div>

          <ContactForm />
        </div>
      </div>
    </section>

    <!-- SUPPORTING CTA -->

    <section class="contact-bottom">
      <div class="container-studio contact-bottom-inner">
        <div>
          <span class="section-kicker">
            EXPLORE THE POSSIBILITIES
          </span>

          <h2>
            Not sure what services you need?
          </h2>
        </div>

        <a
          class="button-outline-light"
          href={`${base}services/`}
        >
          Explore our services
          <span class="button-mark" aria-hidden="true"></span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .contact-hero {
    min-height: 520px;
  }

  .contact-hero .page-title {
    max-width: 1100px;
  }

  .contact-main {
    background: #eeece6;
    color: var(--ink);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: .85fr 1.15fr;
    gap: clamp(60px, 7vw, 125px);
    align-items: start;
  }

  .contact-information {
    padding-top: 25px;
  }

  .contact-information h2 {
    margin: 30px 0;
  }

  .contact-intro {
    max-width: 520px;
    margin: 0;
    color: #66686e;
    font-size: 17px;
    line-height: 1.85;
  }

  .contact-methods {
    display: flex;
    flex-direction: column;
    margin-top: 65px;
  }

  .contact-method {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding: 26px 0;
    border-top: 1px solid #ccc9c1;
  }

  .contact-method > span {
    color: #7b7c81;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .15em;
  }

  .contact-method a,
  .contact-method strong {
    width: fit-content;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 32px);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -.05em;
    overflow-wrap: anywhere;
  }

  .contact-method a:hover {
    color: var(--gold-deep);
  }

  .contact-side-panel {
    position: relative;
    min-height: 260px;
    margin-top: 65px;
    padding: 35px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 95% 5%,
        rgba(214, 180, 125, .18),
        transparent 55%
      ),
      #1c1e22;
    color: #fff;
  }

  .contact-side-panel > span {
    color: var(--gold);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .15em;
  }

  .contact-side-panel p {
    position: relative;
    z-index: 1;
    max-width: 400px;
    margin: 40px 0 0;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -.05em;
  }

  .contact-side-line {
    position: absolute;
    right: -90px;
    bottom: -130px;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(214, 180, 125, .3);
    border-radius: 50%;
    box-shadow: 0 0 0 55px rgba(214, 180, 125, .04);
  }

  .contact-form-column {
    min-width: 0;
  }

  .contact-form-heading {
    padding: 0 0 35px;
  }

  .contact-form-heading h2 {
    margin: 22px 0 15px;
    font-family: var(--font-display);
    font-size: clamp(32px, 3.5vw, 55px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -.065em;
  }

  .contact-form-heading p {
    max-width: 540px;
    margin: 0;
    color: #696b71;
    font-size: 14px;
    line-height: 1.8;
  }

  .contact-bottom {
    background: #16171b;
    padding: 75px 0;
  }

  .contact-bottom-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 50px;
  }

  .contact-bottom h2 {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: clamp(27px, 3vw, 43px);
    font-weight: 700;
    letter-spacing: -.055em;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 75px;
    }

    .contact-information {
      padding-top: 0;
    }

    .contact-side-panel {
      margin-top: 45px;
    }
  }

  @media (max-width: 600px) {
    .contact-methods {
      margin-top: 40px;
    }

    .contact-side-panel {
      min-height: 230px;
      padding: 25px;
    }

    .contact-side-panel p {
      font-size: 23px;
    }

    .contact-bottom-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 30px;
    }
  }
</style>
