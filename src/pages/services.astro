---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceList from '../components/ServiceList.astro';
import services from '../content/services.json';
---
<BaseLayout
  title="Services | Triple9 Design"
  description="We design websites, brands, and iOS apps. We also handle social media, advertising, local search, hosting, and ongoing care."
>
  <header class="page-intro wrap">
    <h1 class="display" set:html={services.headline}></h1>
    <p class="reading">{services.sub}</p>
  </header>
  <div class="wrap service-catalog"><ServiceList detailed /></div>
  <CtaBand />
</BaseLayout>
