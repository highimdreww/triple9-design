---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import home from '../content/home.json';
import servicesData from '../content/services.json';

const base = import.meta.env.BASE_URL;

const featuredServices = servicesData.services;

const principles = [
  {
    title: 'Understand the opportunity',
    description: 'We start with your business, your audience, and what success should look like.'
  },
  {
    title: 'Create with intention',
    description: 'We develop a cohesive direction that makes every interaction feel unmistakably yours.'
  },
  {
    title: 'Build for what comes next',
    description: 'We connect design, technology, and marketing to support long-term momentum.'
  }
];
---

<BaseLayout
  title="Triple9 Design | Branding, Web Design & Digital Marketing"
  description="Triple9 Design is a full-service digital agency specializing in brand identity, web design, social media marketing, advertising, SEO, and website care."
>
  <Header />

  <main class="page-shell">
    <!-- HERO -->

    <section class="home-hero mesh-surface">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="container-studio home-hero-inner">
        <div class="hero-copy">
          <span class="section-kicker reveal">
            {home.eyebrow}
          </span>

          <h1 class="display-title reveal delay-1">
            Make your brand
            <span class="hero-accent">impossible</span>
            to ignore.
          </h1>

          <div class="hero-lower reveal delay-2">
            <p>{home.description}</p>

            <div class="hero-buttons">
              <a class="button-gold" href={`${base}contact/`}>
                {home.primaryCta}
                <span class="button-mark" aria-hidden="true"></span>
              </a>

              <a
                class="button-outline-light"
                href={`${base}services/`}
              >
                {home.secondaryCta}
              </a>
            </div>
          </div>
        </div>

        <div class="hero-art" aria-hidden="true">
          <div class="art-ring ring-one"></div>
          <div class="art-ring ring-two"></div>
          <div class="art-ring ring-three"></div>

          <div class="art-center">
            <span>THINK BIGGER.</span>
            <strong>999</strong>
            <span>BUILD BETTER.</span>
          </div>

          <div class="art-beam"></div>
        </div>
      </div>

      <div class="hero-bottom-bar">
        <div class="container-studio">
          <span>BRAND IDENTITY</span>
          <span>WEB EXPERIENCES</span>
          <span>DIGITAL GROWTH</span>
          <span>TRIPLE9 DESIGN</span>
        </div>
      </div>
    </section>

    <!-- INTRO -->

    <section class="section-pad light-surface intro-section">
      <div class="container-studio intro-grid">
        <div class="reveal">
          <span class="section-kicker dark">
            {home.introEyebrow}
          </span>
        </div>

        <div class="reveal delay-1">
          <h2 class="section-title">
            {home.introHeading}
          </h2>

          <p class="intro-copy">{home.introBody}</p>

          <a class="text-link-dark" href={`${base}about/`}>
            Discover Triple9
            <span aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <!-- SERVICES -->

    <section class="section-pad dark-surface home-services">
      <div class="container-studio">
        <div class="section-heading-row reveal">
          <div>
            <span class="section-kicker">
              {home.servicesEyebrow}
            </span>

            <h2 class="section-title">
              {home.servicesHeading}
            </h2>
          </div>

          <p>{home.servicesDescription}</p>
        </div>

        <div class="home-services-grid">
          {featuredServices.map((service, index) => (
            <a
              href={`${base}services/#${service.id}`}
              class:list={[
                'service-tile',
                'reveal',
                { 'service-tile-featured': service.id === 'brand-identity' }
              ]}
            >
              <div class="service-tile-top">
                <span>
                  {service.id === 'brand-identity'
                    ? 'FLAGSHIP SERVICE'
                    : 'TRIPLE9 EXPERTISE'}
                </span>

                <span class="tile-symbol" aria-hidden="true"></span>
              </div>

              <div>
                <h3>{service.title}</h3>
                <p>{service.summary}</p>

                <div class="service-tile-footer">
                  <span>EXPLORE SERVICE</span>
                  <span class="tile-line" aria-hidden="true"></span>
                </div>
              </div>
            </a>
          ))}
        </div>

        <div class="services-end reveal">
          <p>
            One cohesive vision. Every channel working together.
          </p>

          <a class="button-outline-light" href={`${base}services/`}>
            All services
            <span class="button-mark" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <!-- FLAGSHIP BRANDING -->

    <section class="section-pad brand-feature">
      <div class="container-studio brand-feature-grid">
        <div class="brand-feature-visual reveal" aria-hidden="true">
          <div class="brand-visual-grid"></div>

          <div class="brand-frame frame-outer">
            <div class="brand-frame frame-inner">
              <span class="brand-visual-word">IDENTITY</span>
              <strong>9</strong>
              <span class="brand-visual-caption">
                THE ART OF BEING DISTINCT.
              </span>
            </div>
          </div>

          <span class="brand-visual-corner corner-top">
            TRIPLE9 / CREATIVE
          </span>

          <span class="brand-visual-corner corner-bottom">
            BUILT TO BE RECOGNIZED
          </span>
        </div>

        <div class="brand-feature-content reveal delay-1">
          <span class="section-kicker dark">
            {home.brandEyebrow}
          </span>

          <h2 class="section-title">
            {home.brandHeading}
          </h2>

          <p>{home.brandDescription}</p>

          <div class="brand-feature-points">
            <span>LOGO SYSTEMS</span>
            <span>VISUAL IDENTITY</span>
            <span>BRAND GUIDELINES</span>
            <span>CREATIVE DIRECTION</span>
          </div>

          <a
            class="button-dark"
            href={`${base}services/#brand-identity`}
          >
            Explore brand identity
            <span class="button-mark" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <!-- APPROACH -->

    <section class="section-pad approach-section mesh-surface">
      <div class="container-studio">
        <div class="approach-top reveal">
          <span class="section-kicker">
            {home.approachEyebrow}
          </span>

          <h2 class="section-title">
            {home.approachHeading}
          </h2>

          <p class="lead-copy">
            {home.approachDescription}
          </p>
        </div>

        <div class="approach-grid">
          {principles.map((principle, index) => (
            <div class="approach-card reveal">
              <div class="approach-card-top">
                <span class="approach-dot" aria-hidden="true"></span>
                <span>TRIPLE9 METHOD</span>
              </div>

              <h3>{principle.title}</h3>
              <p>{principle.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->

    <section class="section-pad light-surface">
      <div class="container-studio">
        <div class="cta-panel reveal">
          <span class="section-kicker">
            {home.closingEyebrow}
          </span>

          <h2>{home.closingHeading}</h2>

          <p>{home.closingDescription}</p>

          <a class="button-gold" href={`${base}contact/`}>
            Request a consultation
            <span class="button-mark" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .home-hero {
    min-height: 880px;
    padding-top: 96px;
  }

  .home-hero-inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 720px;
    padding-top: 85px;
    padding-bottom: 90px;
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    width: 100%;
  }

  .hero-copy h1 {
    position: relative;
    max-width: 1100px;
    margin: 35px 0 50px;
  }

  .hero-accent {
    display: block;
    color: var(--gold);
  }

  .hero-lower {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 50px;
    max-width: 1020px;
  }

  .hero-lower > p {
    max-width: 475px;
    margin: 0;
    color: #b4b6bc;
    font-size: clamp(17px, 1.7vw, 22px);
    line-height: 1.75;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-art {
    position: absolute;
    right: -220px;
    top: 70px;
    z-index: 1;
    width: 750px;
    height: 750px;
    pointer-events: none;
    opacity: .8;
  }

  .art-ring {
    position: absolute;
    inset: 0;
    border: 1px solid rgba(214, 180, 125, .22);
    border-radius: 50%;
  }

  .ring-two {
    inset: 90px;
    border-color: rgba(214, 180, 125, .33);
  }

  .ring-three {
    inset: 180px;
    border-color: rgba(214, 180, 125, .48);
    background:
      radial-gradient(
        circle,
        rgba(214, 180, 125, .13),
        transparent 75%
      );
  }

  .art-center {
    position: absolute;
    inset: 235px 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  .art-center span {
    color: rgba(214, 180, 125, .7);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .22em;
  }

  .art-center strong {
    color: rgba(214, 180, 125, .38);
    font-family: var(--font-display);
    font-size: 90px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.11em;
  }

  .art-beam {
    position: absolute;
    top: 50%;
    left: -80px;
    width: 900px;
    height: 1px;
    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(214, 180, 125, .55),
        transparent
      );
    transform: rotate(-30deg);
  }

  .hero-glow {
    position: absolute;
    right: -15%;
    top: -20%;
    width: 60%;
    height: 100%;
    background:
      radial-gradient(
        ellipse,
        rgba(214, 180, 125, .12),
        transparent 65%
      );
    pointer-events: none;
  }

  .hero-bottom-bar {
    border-top: 1px solid var(--line-dark);
    border-bottom: 1px solid var(--line-dark);
    background: rgba(0, 0, 0, .2);
  }

  .hero-bottom-bar .container-studio {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    min-height: 72px;
  }

  .hero-bottom-bar span {
    color: #9e9fa5;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .16em;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: .45fr 1fr;
    gap: 100px;
  }

  .intro-grid h2 {
    max-width: 1050px;
    margin: 0;
  }

  .intro-copy {
    max-width: 680px;
    margin: 40px 0;
    color: #62656b;
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.75;
  }

  .text-link-dark {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--gold-deep);
    font-size: 12px;
    font-weight: 700;
  }

  .text-link-dark span {
    width: 25px;
    height: 1px;
    background: var(--gold-deep);
  }

  .home-services {
    background:
      radial-gradient(
        ellipse at 90% 5%,
        rgba(214, 180, 125, .08),
        transparent 35%
      ),
      #111216;
  }

  .home-services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .service-tile-featured {
    background:
      radial-gradient(
        ellipse at 90% 10%,
        rgba(214, 180, 125, .25),
        transparent 55%
      ),
      linear-gradient(145deg, #383126, #1d1c1b);
    border-color: rgba(214, 180, 125, .5);
  }

  .services-end {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    margin-top: 45px;
  }

  .services-end p {
    margin: 0;
    color: #9e9fa5;
    font-size: 14px;
  }

  .brand-feature {
    background: #ebe9e2;
    color: var(--ink);
  }

  .brand-feature-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(55px, 8vw, 125px);
    align-items: center;
  }

  .brand-feature-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 650px;
    overflow: hidden;
    background:
      radial-gradient(
        ellipse at 30% 20%,
        rgba(214, 180, 125, .16),
        transparent 45%
      ),
      #16171a;
    color: #fff;
  }

  .brand-visual-grid {
    position: absolute;
    inset: 0;
    opacity: .2;
    background-image:
      linear-gradient(rgba(255, 255, 255, .12) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .12) 1px, transparent 1px);
    background-size: 55px 55px;
  }

  .brand-frame {
    position: relative;
    display: grid;
    place-items: center;
    width: 70%;
    aspect-ratio: 1;
    border: 1px solid rgba(214, 180, 125, .45);
    transform: rotate(45deg);
  }

  .frame-outer {
    box-shadow: 0 0 70px rgba(214, 180, 125, .09);
  }

  .frame-inner {
    width: 72%;
    border-color: rgba(214, 180, 125, .65);
    transform: none;
  }

  .frame-inner strong,
  .brand-visual-word,
  .brand-visual-caption {
    position: absolute;
    transform: rotate(-45deg);
  }

  .frame-inner strong {
    font-family: var(--font-display);
    font-size: clamp(110px, 16vw, 220px);
    font-weight: 800;
    letter-spacing: -.13em;
    color: var(--gold);
  }

  .brand-visual-word {
    top: -38px;
    left: -35px;
    color: var(--gold);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .brand-visual-caption {
    bottom: -36px;
    right: -45px;
    width: 210px;
    color: #a8a8a8;
    font-size: 8px;
    letter-spacing: .16em;
  }

  .brand-visual-corner {
    position: absolute;
    color: #999;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .15em;
  }

  .corner-top {
    top: 30px;
    left: 30px;
  }

  .corner-bottom {
    bottom: 30px;
    right: 30px;
  }

  .brand-feature-content h2 {
    margin: 30px 0;
  }

  .brand-feature-content > p {
    max-width: 550px;
    margin: 0;
    color: #606168;
    font-size: 17px;
    line-height: 1.85;
  }

  .brand-feature-points {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 17px 25px;
    margin: 42px 0;
    padding-top: 25px;
    border-top: 1px solid #c9c6bf;
  }

  .brand-feature-points span {
    color: #55575d;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .09em;
  }

  .approach-top {
    max-width: 950px;
  }

  .approach-top h2 {
    margin: 30px 0;
  }

  .approach-top .lead-copy {
    max-width: 660px;
  }

  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 85px;
  }

  .approach-card {
    display: flex;
    flex-direction: column;
    min-height: 315px;
    padding: 30px;
    border: 1px solid var(--line-dark);
    background: rgba(255, 255, 255, .035);
    backdrop-filter: blur(12px);
  }

  .approach-card-top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: auto;
    color: #999ba1;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .15em;
  }

  .approach-dot {
    width: 8px;
    height: 8px;
    border: 1px solid var(--gold);
    transform: rotate(45deg);
  }

  .approach-card h3 {
    margin: 45px 0 17px;
    font-family: var(--font-display);
    font-size: 27px;
    font-weight: 700;
    letter-spacing: -.055em;
    line-height: 1.25;
  }

  .approach-card p {
    margin: 0;
    color: #a4a6ac;
    font-size: 14px;
    line-height: 1.8;
  }

  @media (max-width: 1100px) {
    .hero-art {
      right: -370px;
      opacity: .45;
    }

    .home-services-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .brand-feature-grid {
      gap: 55px;
    }

    .brand-feature-visual {
      min-height: 540px;
    }
  }

  @media (max-width: 900px) {
    .home-hero {
      min-height: 0;
    }

    .home-hero-inner {
      min-height: 700px;
    }

    .hero-lower {
      align-items: flex-start;
      flex-direction: column;
      gap: 30px;
    }

    .intro-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }

    .brand-feature-grid {
      grid-template-columns: 1fr;
    }

    .brand-feature-visual {
      min-height: 520px;
    }

    .approach-grid {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-top: 55px;
    }

    .approach-card {
      min-height: 230px;
    }

    .approach-card h3 {
      margin-top: 35px;
    }
  }

  @media (max-width: 600px) {
    .home-hero-inner {
      min-height: 730px;
      padding-top: 70px;
      padding-bottom: 70px;
    }

    .hero-copy h1 {
      margin: 30px 0 40px;
    }

    .hero-art {
      right: -550px;
      top: 100px;
      opacity: .22;
    }

    .hero-buttons {
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }

    .hero-bottom-bar .container-studio {
      justify-content: space-between;
      min-height: 65px;
    }

    .hero-bottom-bar span:nth-child(2),
    .hero-bottom-bar span:nth-child(3) {
      display: none;
    }

    .home-services-grid {
      grid-template-columns: 1fr;
    }

    .services-end {
      flex-direction: column;
      align-items: flex-start;
    }

    .brand-feature-visual {
      min-height: 360px;
    }

    .brand-visual-word,
    .brand-visual-caption {
      display: none;
    }

    .frame-inner strong {
      font-size: 110px;
    }

    .brand-feature-points {
      gap: 17px;
    }
  }
</style>
