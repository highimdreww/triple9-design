---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceList from '../components/ServiceList.astro';
import home from '../content/home.json';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Triple9 Design | Websites, Brands, Apps & Marketing"
  description="We’re a design studio in St. Cloud, Florida. We make websites, brands, iOS apps, and marketing for local businesses."
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-lockup wrap">
      <div class="nine-mark" aria-hidden="true"><span>9</span><span>9</span><span>9</span></div>
      <h1 id="hero-title" set:html={home.headline}></h1>
      <a class="btn btn-accent" href={`${base}contact/`} data-open-contact>{home.primaryCtaLabel}</a>
    </div>
  </section>

  <section class="manifesto chapter">
    <div class="wrap">
      <h2 class="display reveal" set:html={home.manifesto}></h2>
      <p class="reading reveal">{home.sub}</p>
    </div>
  </section>

  <section id="services" class="work chapter">
    <div class="wrap">
      <h2 class="display reveal">{home.servicesHeading}</h2>
      <ServiceList />
    </div>
  </section>

  <section class="product chapter" aria-labelledby="product-title">
    <div class="wrap">
      <h2 class="display reveal" id="product-title">{home.app.heading}</h2>
      <p class="reading reveal">{home.app.description}</p>
      <figure class="device reveal">
        <img src={`${base}images/e11vn-train.jpg`} alt="The E11VN Train screen with a weekly calendar, muscle recovery map, and upper-body workout." width="1260" height="2586" loading="lazy" decoding="async" />
        <figcaption><strong>{home.app.name}</strong><span>{home.app.tagline}</span></figcaption>
      </figure>
      <dl class="product-facts">
        {home.app.features.map((fact) => (
          <div class="reveal"><dt>{fact.title}</dt><dd>{fact.text}</dd></div>
        ))}
      </dl>
      <a class="btn btn-accent v5-app-cta reveal" href={`${base}contact/`} data-open-contact>Talk to us about an app</a>
    </div>
  </section>

  <section class="chapter approach">
    <div class="wrap approach-layout">
      <h2 class="display reveal" set:html={home.whyHeading}></h2>
      <div class="principles">
        {home.why.map((point) => (
          <article class="reveal"><h3>{point.title}</h3><p>{point.text}</p></article>
        ))}
        <a class="btn btn-accent" href={`${base}contact/`} data-open-contact>Make something worth seeing</a>
      </div>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
