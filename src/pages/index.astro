---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import home from '../content/home.json';

const base = import.meta.env.BASE_URL;
---
<BaseLayout
  title="Triple9 Design — Websites, Branding & Marketing"
  description="Triple9 is a digital agency for local businesses. We design websites, brands, and marketing that make customers choose you."
>
  <section class="hero">
    <div class="nine-motif" aria-hidden="true"><span class="n1">9</span><span class="n2">9</span><span class="n3">9</span></div>
    <div class="wrap">
      <p class="kicker reveal">{home.eyebrow}</p>
      <h1 class="display reveal" set:html={home.headline}></h1>
      <p class="sub reveal">{home.sub}</p>
      <div class="hero-ctas reveal">
        <a class="btn btn-accent" href={`${base}contact/`}>{home.primaryCtaLabel}</a>
        <a class="btn btn-white" href={`${base}services/`}>{home.secondaryCtaLabel}</a>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>Web Design</span><i></i><span>Rebrands</span><i></i><span>Social Media</span><i></i><span>Advertising</span><i></i><span>SEO</span><i></i><span>Care Plans</span><i></i>
      <span>Web Design</span><i></i><span>Rebrands</span><i></i><span>Social Media</span><i></i><span>Advertising</span><i></i><span>SEO</span><i></i><span>Care Plans</span><i></i>
    </div>
  </div>

  <section class="section section-soft">
    <div class="wrap">
      <p class="kicker reveal">{home.servicesEyebrow}</p>
      <h2 class="display section-h reveal">{home.servicesHeading}</h2>
      <div class="cards">
        {home.services.map((s) => (
          <div class="card reveal">
            <span class="tick" aria-hidden="true"></span>
            <h3>{s.name}</h3>
            <p>{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="kicker reveal">{home.whyEyebrow}</p>
      <h2 class="display section-h reveal">{home.whyHeading}</h2>
      <div class="why-grid">
        {home.why.map((w) => (
          <div class="reveal">
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
