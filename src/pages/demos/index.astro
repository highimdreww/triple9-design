---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WorkCard from '../../components/WorkCard.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Selected Work | Triple9 Design"
  description="Explore premium website concepts from Triple9 Design, an independent web design studio in St. Cloud, Florida."
>
  <Header />

  <main>
    <section class="demos-hero">
      <div class="container-studio">
        <div class="hero-meta reveal">
          <span class="eyebrow">
            TRIPLE9 DESIGN / PORTFOLIO
          </span>

          <span>SELECTED CONCEPT PROJECTS</span>
        </div>

        <h1 class="section-heading reveal delay-1">
          Different businesses.
          <br />
          Distinctive websites.
        </h1>

        <div class="hero-bottom reveal delay-2">
          <p>
            Every business has its own personality.
            Its website should too. Explore two concepts
            built around different industries, audiences,
            and visual identities.
          </p>

          <span>01 — 02</span>
        </div>
      </div>
    </section>

    <section class="projects">
      <div class="container-studio">
        <div class="projects-grid">
          <div class="reveal">
            <WorkCard
              number="01"
              title="Space Coast Sewer and Drain"
              category="Sewer & Drain"
              location="Merritt Island, Florida"
              href={`${base}demos/spacecoast/`}
              variant="dark"
            />
          </div>

          <div class="reveal delay-1">
            <WorkCard
              number="02"
              title="Bk Landscaping"
              category="Lawn Care & Landscaping"
              location="St. Cloud, Florida"
              href={`${base}demos/bk-landscaping/`}
              variant="light"
            />
          </div>
        </div>

        <div class="portfolio-note reveal">
          <span>ABOUT THESE PROJECTS</span>

          <p>
            These are independent design concepts created
            to demonstrate the potential of a premium,
            purpose-built business website. They are not
            presented as commissioned client projects.
          </p>
        </div>
      </div>
    </section>

    <section class="demos-cta">
      <div class="container-studio reveal">
        <span class="eyebrow">
          YOUR BUSINESS IS NEXT
        </span>

        <h2 class="section-heading">
          Let's build yours.
        </h2>

        <a
          href="tel:+14077640241"
          class="button-light"
        >
          Start a project
        </a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* HERO */

  .demos-hero {
    padding: clamp(90px, 12vw, 180px) 0 90px;
    background: #f5f5f3;
  }

  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    align-items: center;
  }

  .hero-meta > span:last-child {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .demos-hero h1 {
    max-width: 1250px;
    margin: 85px 0;
  }

  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 30px;
    padding-top: 25px;
    border-top: 1px solid #bbb;
  }

  .hero-bottom p {
    max-width: 490px;
    margin: 0;
    color: #666;
    font-size: 17px;
    line-height: 1.7;
  }

  .hero-bottom span {
    font-size: 11px;
    font-weight: 700;
  }

  /* PROJECTS */

  .projects {
    padding: 110px 0 140px;
    background: #fff;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }

  .portfolio-note {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 50px;
    padding-top: 35px;
    margin-top: 95px;
    border-top: 1px solid #ccc;
  }

  .portfolio-note span {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .13em;
  }

  .portfolio-note p {
    max-width: 630px;
    margin: 0;
    color: #777;
    font-size: 14px;
    line-height: 1.85;
  }

  /* CTA */

  .demos-cta {
    padding: clamp(110px, 13vw, 200px) 0;
    background: #111;
    color: #fff;
  }

  .demos-cta h2 {
    max-width: 1100px;
    margin: 50px 0 65px;
  }

  .demos-cta .button-light {
    min-width: 180px;
  }

  /* TABLET */

  @media (max-width: 900px) {
    .demos-hero {
      padding: 100px 0 75px;
    }

    .demos-hero h1 {
      margin: 75px 0;
    }

    .projects {
      padding: 90px 0 110px;
    }

    .projects-grid {
      gap: 18px;
    }

    .portfolio-note {
      margin-top: 75px;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    .demos-hero {
      padding: 75px 0 65px;
    }

    .hero-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 15px;
    }

    .hero-meta > span:last-child {
      color: #888;
      font-size: 9px;
    }

    .demos-hero h1 {
      margin: 65px 0;
    }

    .hero-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .hero-bottom p {
      font-size: 15px;
    }

    .projects {
      padding: 75px 0 95px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
      gap: 50px;
    }

    .portfolio-note {
      grid-template-columns: 1fr;
      gap: 20px;
      margin-top: 70px;
    }

    .portfolio-note p {
      font-size: 13px;
    }

    .demos-cta h2 {
      margin: 40px 0 50px;
    }
  }
</style>
