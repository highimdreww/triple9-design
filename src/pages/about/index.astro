---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

import about from '../../content/about.json';

const base = import.meta.env.BASE_URL;

const values = Array.isArray(about.values)
  ? about.values
  : [];
---

<BaseLayout
  title="About Triple9 Design | Creative Strategy & Digital Excellence"
  description="Learn about Triple9 Design, a full-service digital agency bringing brand strategy, identity, web development, and marketing together."
>
  <Header />

  <main class="page-shell">
    <!-- HERO -->

    <section class="page-hero mesh-surface about-hero">
      <div class="page-hero-orbit" aria-hidden="true"></div>

      <div class="container-studio page-hero-content">
        <span class="section-kicker reveal">
          {about.eyebrow}
        </span>

        <h1 class="page-title reveal delay-1">
          {about.headline}
        </h1>

        <p class="lead-copy reveal delay-2">
          {about.introduction}
        </p>
      </div>
    </section>

    <!-- MISSION -->

    <section class="section-pad light-surface mission-section">
      <div class="container-studio mission-grid">
        <div class="mission-visual reveal" aria-hidden="true">
          <div class="mission-grid-lines"></div>

          <div class="mission-circle circle-one"></div>
          <div class="mission-circle circle-two"></div>

          <div class="mission-core">
            <span>THE TRIPLE9 STANDARD</span>
            <strong>999</strong>
            <span>ALWAYS INTENTIONAL.</span>
          </div>

          <div class="mission-visual-bottom">
            <span>FORM</span>
            <span>FUNCTION</span>
            <span>IMPACT</span>
          </div>
        </div>

        <div class="mission-copy reveal delay-1">
          <span class="section-kicker dark">
            {about.missionEyebrow}
          </span>

          <h2 class="section-title">
            {about.missionHeading}
          </h2>

          <p>{about.missionBody}</p>

          <a class="button-dark" href={`${base}services/`}>
            Explore our capabilities
            <span class="button-mark" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <!-- VALUES -->

    <section class="section-pad values-section">
      <div class="container-studio">
        <div class="values-intro reveal">
          <span class="section-kicker">
            WHAT DEFINES OUR WORK
          </span>

          <h2 class="section-title">
            Our principles aren't decoration.
            <span class="text-gold">They're the foundation.</span>
          </h2>
        </div>

        <div class="values-grid">
          {values.map((value) => (
            <article class="value-card reveal">
              <div class="value-card-top">
                <span class="value-diamond" aria-hidden="true"></span>
                <span>TRIPLE9 PRINCIPLE</span>
              </div>

              <h3>{value.title}</h3>

              <p>{value.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- APPROACH -->

    <section class="section-pad approach-light">
      <div class="container-studio approach-light-grid">
        <div class="reveal">
          <span class="section-kicker dark">
            {about.approachEyebrow}
          </span>

          <h2 class="section-title">
            {about.approachHeading}
          </h2>
        </div>

        <div class="approach-light-right reveal delay-1">
          <p>{about.approachBody}</p>

          <div class="approach-tags">
            <span>STRATEGY</span>
            <span>DESIGN</span>
            <span>DEVELOPMENT</span>
            <span>MARKETING</span>
          </div>

          <div class="location-note">
            <span class="location-marker" aria-hidden="true"></span>
            {about.location}
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->

    <section class="section-pad dark-surface">
      <div class="container-studio">
        <div class="cta-panel reveal">
          <span class="section-kicker">
            THE NEXT MOVE
          </span>

          <h2>
            Ready to raise the standard?
          </h2>

          <p>
            Let's talk about where your business is today
            and the brand you want to build tomorrow.
          </p>

          <a class="button-gold" href={`${base}contact/`}>
            Request a consultation
            <span class="button-mark" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .about-hero .page-title {
    max-width: 1150px;
  }

  .mission-grid {
    display: grid;
    grid-template-columns: .95fr 1.05fr;
    gap: clamp(60px, 8vw, 130px);
    align-items: center;
  }

  .mission-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 620px;
    overflow: hidden;
    background:
      radial-gradient(
        circle at 50% 45%,
        rgba(214, 180, 125, .17),
        transparent 45%
      ),
      #191a1e;
    color: #fff;
  }

  .mission-grid-lines {
    position: absolute;
    inset: 0;
    opacity: .13;
    background-image:
      linear-gradient(
        rgba(255, 255, 255, .16) 1px,
        transparent 1px
      ),
      linear-gradient(
        90deg,
        rgba(255, 255, 255, .16) 1px,
        transparent 1px
      );
    background-size: 55px 55px;
  }

  .mission-circle {
    position: absolute;
    width: 65%;
    aspect-ratio: 1;
    border: 1px solid rgba(214, 180, 125, .45);
    border-radius: 50%;
  }

  .circle-two {
    width: 48%;
    border-color: rgba(214, 180, 125, .65);
    box-shadow: 0 0 0 65px rgba(214, 180, 125, .025);
  }

  .mission-core {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }

  .mission-core strong {
    color: var(--gold);
    font-family: var(--font-display);
    font-size: clamp(85px, 10vw, 155px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -.12em;
  }

  .mission-core span {
    color: #bcb2a4;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .2em;
  }

  .mission-visual-bottom {
    position: absolute;
    right: 30px;
    bottom: 30px;
    left: 30px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #8e8f95;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .15em;
  }

  .mission-copy h2 {
    margin: 30px 0;
  }

  .mission-copy > p {
    max-width: 630px;
    margin: 0 0 40px;
    color: #62646a;
    font-size: 17px;
    line-height: 1.95;
  }

  .values-section {
    background:
      radial-gradient(
        ellipse at 80% 0,
        rgba(214, 180, 125, .12),
        transparent 40%
      ),
      #111216;
  }

  .values-intro {
    max-width: 1020px;
  }

  .values-intro h2 {
    margin: 30px 0 65px;
  }

  .values-intro h2 span {
    display: block;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 15px;
  }

  .value-card {
    display: flex;
    flex-direction: column;
    min-height: 360px;
    padding: 30px;
    background:
      linear-gradient(
        150deg,
        rgba(214, 180, 125, .07),
        transparent 60%
      ),
      #1d1f24;
    border: 1px solid rgba(255, 255, 255, .1);
  }

  .value-card-top {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: auto;
    color: #999ba1;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .value-diamond {
    width: 9px;
    height: 9px;
    border: 1px solid var(--gold);
    transform: rotate(45deg);
  }

  .value-card h3 {
    margin: 50px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(27px, 2.5vw, 39px);
    font-weight: 700;
    letter-spacing: -.055em;
  }

  .value-card p {
    margin: 0;
    color: #a5a7ad;
    font-size: 13px;
    line-height: 1.85;
  }

  .approach-light {
    background: #eae8e2;
    color: var(--ink);
  }

  .approach-light-grid {
    display: grid;
    grid-template-columns: 1fr .85fr;
    gap: clamp(65px, 9vw, 155px);
    align-items: start;
  }

  .approach-light h2 {
    margin: 30px 0 0;
  }

  .approach-light-right {
    padding-top: 60px;
  }

  .approach-light-right > p {
    margin: 0;
    color: #62646a;
    font-size: clamp(18px, 2vw, 25px);
    line-height: 1.75;
  }

  .approach-tags {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin: 45px 0;
    padding-top: 30px;
    border-top: 1px solid #c8c5bd;
  }

  .approach-tags span {
    color: #62646a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
  }

  .location-note {
    display: flex;
    align-items: center;
    gap: 15px;
    color: #62646a;
    font-size: 13px;
    line-height: 1.7;
  }

  .location-marker {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
    background: var(--gold-deep);
    transform: rotate(45deg);
  }

  @media (max-width: 1100px) {
    .values-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .value-card {
      min-height: 290px;
    }
  }

  @media (max-width: 900px) {
    .mission-grid,
    .approach-light-grid {
      grid-template-columns: 1fr;
    }

    .mission-visual {
      min-height: 480px;
    }

    .approach-light-right {
      padding-top: 0;
    }
  }

  @media (max-width: 600px) {
    .mission-visual {
      min-height: 350px;
    }

    .mission-core strong {
      font-size: 90px;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .value-card {
      min-height: 260px;
    }

    .approach-tags {
      gap: 15px;
    }
  }
</style>
