---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import about from '../content/about.json';
---
<BaseLayout
  title="About | Triple9 Design"
  description="We’re a small studio in Orlando, Florida. The people you talk to are the people designing and building for your business."
>
  <header class="studio-intro">
    <div class="page-intro wrap">
      <h1 class="display" set:html={about.headline}></h1>
      <p class="reading">{about.body}</p>
    </div>
  </header>
  <div class="wrap values">
    {about.values.map((value) => (
      <section class="value reveal"><h2>{value.title}</h2><p>{value.text}</p></section>
    ))}
  </div>
  <CtaBand />
</BaseLayout>
