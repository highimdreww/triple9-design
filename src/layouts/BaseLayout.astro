---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactPopup from '../components/ContactPopup.astro';
import '../styles/global.css';

const {
  title = 'Triple9 Design — Websites, Branding & Marketing',
  description = 'Triple9 is a digital agency for local businesses. Websites, branding, and marketing that make customers choose you.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname.replace(/^\//, ''), 'https://highimdreww.github.io/triple9-design/').href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/jpeg" href={`${base}images/triple9-logo.jpg`} />
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <ContactPopup />
  <script>
    const btn = document.getElementById('menuBtn');
    const nav = document.getElementById('siteNav');
    if (btn && nav) {
      btn.addEventListener('click', () => nav.classList.toggle('open'));
      nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => nav.classList.remove('open')));
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
  <script>
    const contactOverlay = document.querySelector('[data-contact-popup]');
    const contactModal = contactOverlay ? contactOverlay.querySelector('[data-contact-modal]') : null;
    let contactPreviousFocus = null;

    function openContactPopup() {
      if (!contactOverlay || !contactModal) return;
      contactPreviousFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      contactOverlay.classList.add('is-open');
      contactOverlay.setAttribute('aria-hidden', 'false');
      document.body.classList.add('popup-open');
      const closeButton = contactOverlay.querySelector('[data-close-contact]');
      if (closeButton) closeButton.focus();
    }

    function closeContactPopup() {
      if (!contactOverlay) return;
      contactOverlay.classList.remove('is-open');
      contactOverlay.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('popup-open');
      if (contactPreviousFocus) contactPreviousFocus.focus();
      contactPreviousFocus = null;
    }

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const trigger = target.closest('a[href="#contactpopup"], [data-open-contact]');
      if (trigger) {
        event.preventDefault();
        openContactPopup();
        return;
      }
      if (target.closest('[data-close-contact]')) {
        closeContactPopup();
        return;
      }
      if (target === contactOverlay) {
        closeContactPopup();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && contactOverlay && contactOverlay.classList.contains('is-open')) {
        event.preventDefault();
        closeContactPopup();
      }
    });
  </script>
</body>
</html>
